{
  "name": "dsh-budget-guard",
  "version": "0.1.0",
  "description": "Deadline budgets for DSH tool calls: classifies each call, arms a tight deadline for undeclared tools, returns actionable next-step hints on timeout, and keeps a measured latency ledger so the next budget comes from data instead of a guess.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-budget-guard": "bin/dsh-budget-guard.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./catalog": "./lib/catalog.js",
    "./ledger": "./lib/ledger.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "timeout",
    "deadline",
    "budget",
    "tool-call",
    "latency"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alkaid4521/dsh-budget-guard.git"
  },
  "homepage": "https://github.com/Alkaid4521/dsh-budget-guard#readme",
  "bugs": {
    "url": "https://github.com/Alkaid4521/dsh-budget-guard/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "install": {
      "preferred": "git",
      "git": "https://github.com/Alkaid4521/dsh-budget-guard.git",
      "zip": "https://github.com/Alkaid4521/dsh-budget-guard/archive/refs/heads/main.zip",
      "tarball": "https://github.com/Alkaid4521/dsh-budget-guard/archive/refs/tags/v0.1.0.tar.gz"
    }
  },
  "dshTarget": "0.2.1-rc.2",
  "types": "lib/types/index.d.ts",
  "scripts": {
    "test": "node tests/smoke.mjs",
    "build": "node --check lib/index.js && node --check lib/catalog.js && node --check lib/ledger.js && node --check bin/dsh-budget-guard.js",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "author": "Alkaid4521"
}
